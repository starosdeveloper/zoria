{
  "name": "zoria",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @zoria/client dev",
    "build": "pnpm --filter @zoria/client build",
    "preview": "pnpm --filter @zoria/client preview",
    "watcher": "node apps/watcher/src/main.ts",
    "mock": "node scripts/mock-stand.ts",
    "verify-draw": "node scripts/verify-draw.ts",
    "stand-check": "node scripts/stand-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core && tsc -p apps/watcher && tsc -p apps/client && tsc -p scripts",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
