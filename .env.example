# Web client (Vite). Only names here, never values that are secret.
# Server preset at first launch: stand | prod. Switchable at runtime in «Настройки».
VITE_ZORIA_SERVER=prod
# SHA-256 fingerprint (64 hex) of the prod seal key, from ТЗ part 1 §3 (published 21.09).
VITE_ZORIA_PROD_FINGERPRINT=
# Optional: fingerprint for the stand key; empty = trust-on-first-use with a warning.
VITE_ZORIA_STAND_FINGERPRINT=
