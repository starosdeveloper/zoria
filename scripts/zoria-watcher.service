# systemd user unit. Install:
#   mkdir -p ~/.config/systemd/user && cp scripts/zoria-watcher.service ~/.config/systemd/user/
#   adjust the project path in ExecStart below if it differs, then:
#   systemctl --user daemon-reload && systemctl --user enable --now zoria-watcher
#   loginctl enable-linger "$USER"      # keep running after logout
#   journalctl --user -u zoria-watcher -f
[Unit]
Description=Zoria.net ether watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Quoted: the project directory name ends with a space.
ExecStart=/usr/bin/env node "%h/Documents/zoria /apps/watcher/src/main.ts" run
Restart=always
RestartSec=10
# ZORIA_PASSWORD and ZORIA_INVITATION (0600 file, never in the repository):
EnvironmentFile=%h/.config/zoria/watcher.env
NoNewPrivileges=yes

[Install]
WantedBy=default.target
